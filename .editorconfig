# EditorConfig: https://editorconfig.org — el estilo ya está en el código; esto lo hace explícito.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.java]
indent_size = 4
max_line_length = 120

[*.{js,html,css}]
indent_size = 2

[*.{xml,yml,yaml}]
indent_size = 4

[*.sql]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
