# Copie este archivo como .env y complete los valores. NO suba .env al repositorio.
DB_USER=universidad_app
DB_PASSWORD=cambie-esta-contrasena-larga
MYSQL_ROOT_PASSWORD=cambie-esta-otra-contrasena
# Solo si usa una base de datos externa (en docker-compose se calcula automáticamente):
# DB_URL=jdbc:mysql://HOST:3306/universidad?sslMode=REQUIRED
# Orígenes extra permitidos para CORS (normalmente vacío: front y API comparten dominio)
# CORS_ORIGINS=
