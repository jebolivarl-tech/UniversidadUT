# Copie este archivo a .env y ajuste las claves. .env está en .gitignore y nunca se sube.
MYSQL_ROOT_PASSWORD=cambie_esta_clave_root
DB_USER=universidad
DB_PASSWORD=cambie_esta_clave
# Origenes permitidos para CORS, separados por coma. Vacio = solo http://localhost:8080
CORS_ORIGINS=http://localhost:8080
# Ponga true unicamente si hay HTTPS delante (proxy). Para localhost deje false.
COOKIE_SECURE=false
TRUST_PROXY=false
